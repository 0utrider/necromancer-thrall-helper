<div class="portfolio-wrapper" style="max-height: 78vh; overflow-y: auto; padding-right: 6px;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #444; padding-bottom: 6px;">
        <span style="font-weight: bold; color: #ccc; font-size: 0.9rem;"><i class="fas fa-users"></i> Saved Identities</span>
        <div style="display: flex; gap: 6px;">
            <button type="button" id="export-portfolio-btn" class="sub-btn" title="Export Portfolio to JSON"><i class="fas fa-file-export"></i> Export</button>
            <button type="button" id="import-portfolio-btn" class="sub-btn" title="Import Portfolio from JSON"><i class="fas fa-file-import"></i> Import</button>
        </div>
    </div>

    <section class="portfolio-list" style="max-height: 185px; overflow-y: auto; padding-right: 4px; flex-shrink: 0;">
        {{#if presets.length}}
            {{#each presets}}
                <div class="portfolio-row" data-id="{{this.id}}">
                      <img src="{{this.displayImg}}" alt="{{this.name}}" class="portfolio-portrait">
                    <div class="portfolio-details">
                        <span class="portfolio-name">{{this.name}}{{#if this.isDefault}} <i class="fas fa-star portfolio-default-star" title="Default thrall"></i>{{/if}}</span>
                         {{#if this.isWildcard}}<span class="portfolio-wildcard-tag" title="{{this.img}}"><i class="fas fa-shuffle"></i> {{this.matchCount}} random images</span>{{/if}}
                    </div>
                    <div class="portfolio-actions">
                        <button type="button" class="action-btn edit-preset-btn" title="Edit Thrall">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button type="button" class="action-btn delete-preset-btn" title="Remove from Portfolio">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            {{/each}}
        {{else}}
            <p class="empty-state">Your portfolio is empty. Time to recruit.</p>
        {{/if}}
    </section>

    <hr>

    <section class="portfolio-builder">
        <h3 id="builder-heading">Draft New Thrall</h3>
        <div class="form-group">
            <input type="text" id="new-thrall-name" placeholder="Thrall Name">
        </div>
        <label class="field-label" for="new-thrall-img">Token Art <small>(image or animated .webm; wildcards allowed)</small></label>
        <div class="form-group flexrow">
            <input type="text" id="new-thrall-img" placeholder="path/thrall.webp or path/thrall-*.webm">
            <button type="button" id="img-pick-btn" class="file-picker-btn" title="Browse Files"><i class="fas fa-file-import"></i></button>
            <button type="button" id="wildcard-btn" class="wildcard-btn" title="Make wildcard: replace the number in the filename with * (thrall-01.webp becomes thrall-*.webp)"><i class="fas fa-shuffle"></i></button>
        </div>
        <small id="wildcard-info" class="hint"></small>

        <label class="field-label" for="new-thrall-portrait">Portrait <small>(still image shown in the Command Deck and chat cards; optional)</small></label>
        <div class="form-group flexrow">
            <input type="text" id="new-thrall-portrait" placeholder="Blank = use the token art (or the actor image if the art is animated)">
            <button type="button" id="portrait-pick-btn" class="file-picker-btn" title="Browse Files"><i class="fas fa-file-import"></i></button>
            <button type="button" id="portrait-wildcard-btn" class="wildcard-btn" title="Make wildcard: replace the number in the filename with *"><i class="fas fa-shuffle"></i></button>
        </div>
        <small id="portrait-info" class="hint"></small>

        <label class="field-label" for="new-thrall-ring-subject">Ring Subject <small>(transparent cutout for the dynamic token ring; optional)</small></label>
        <div class="form-group flexrow">
            <input type="text" id="new-thrall-ring-subject" placeholder="Blank = use the token art when it is a still image">
            <button type="button" id="subject-pick-btn" class="file-picker-btn" title="Browse Files"><i class="fas fa-file-import"></i></button>
            <button type="button" id="subject-wildcard-btn" class="wildcard-btn" title="Make wildcard: replace the number in the filename with *"><i class="fas fa-shuffle"></i></button>
        </div>
        <small id="subject-info" class="hint"></small>

        <div class="form-group adjective-section">
            <div class="adjective-header">
                <label>Adjective Pool</label>
                <button type="button" id="select-all-adj-btn" class="sub-btn">Select All</button>
            </div>
            <div class="adjective-checkbox-grid">
                <label><input type="checkbox" name="adjective" value="Angry"> Angry</label>
                <label><input type="checkbox" name="adjective" value="Soggy"> Soggy</label>
                <label><input type="checkbox" name="adjective" value="Vengeful"> Vengeful</label>
                <label><input type="checkbox" name="adjective" value="Festering"> Festering</label>
                <label><input type="checkbox" name="adjective" value="Hollow"> Hollow</label>
                <label><input type="checkbox" name="adjective" value="Shivering"> Shivering</label>
                <label><input type="checkbox" name="adjective" value="Wrinkled"> Wrinkled</label>
                <label><input type="checkbox" name="adjective" value="Spiteful"> Spiteful</label>
                <label><input type="checkbox" name="adjective" value="Damp"> Damp</label>
                <label><input type="checkbox" name="adjective" value="Putrid"> Putrid</label>
                <label><input type="checkbox" name="adjective" value="Screaming"> Screaming</label>
                <label><input type="checkbox" name="adjective" value="Moth-Eaten"> Moth-Eaten</label>
                <label><input type="checkbox" name="adjective" value="Bitter"> Bitter</label>
                <label><input type="checkbox" name="adjective" value="Rancid"> Rancid</label>
                <label><input type="checkbox" name="adjective" value="Happy"> Happy</label>
                <label><input type="checkbox" name="adjective" value="Heroic"> Heroic</label>
                <label><input type="checkbox" name="adjective" value="Stoic"> Stoic</label>
                <label><input type="checkbox" name="adjective" value="Loving"> Loving</label>
                <label><input type="checkbox" name="adjective" value="Earnest"> Earnest</label>
                <label><input type="checkbox" name="adjective" value="Resolved"> Resolved</label>
                <label><input type="checkbox" name="adjective" value="Baffled"> Baffled</label>
            </div>
        </div>

        <div class="form-group">
            <input type="text" id="new-thrall-custom-adj" placeholder="Additional Custom Adjectives (comma-separated)">
        </div>

      <div class="form-group checkbox-group">
            <label>
                <input type="checkbox" id="new-thrall-unique" checked> Is Unique (Limit one active on field)
            </label>
        </div>
        <div class="form-group checkbox-group" style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
            <label title="Summoning the plain (Default Thrall) will use this profile instead">
                <input type="checkbox" id="new-thrall-default"> Use as my default thrall
            </label>
            <button type="button" id="reset-default-thrall-btn" class="sub-btn" style="flex: 0 0 auto; width: auto;" title="Go back to the standard Default Thrall (clears the profile marked as default)"><i class="fas fa-rotate-left"></i> Reset default</button>
        </div>
        <div class="form-group checkbox-group">
            <label>
                <input type="checkbox" id="new-thrall-ring" checked> Enable Token Ring
            </label>
            <small id="ring-hint" class="hint"></small>
        </div>
        <div class="form-group" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <label>Token Art Scale:</label>
            <div style="display: flex; align-items: center; gap: 8px;">
                <input type="range" id="new-thrall-scale" min="0.25" max="5" step="0.05" value="1" style="width: 100px;">
                <input type="number" min="0.25" max="5" step="0.05" value="1" style="width: 58px; text-align: right; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid #555;" id="new-thrall-scale-val" title="Type an exact value">
            </div>
        </div>
        <div class="form-group" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <label>Ring Subject Scale:</label>
            <div style="display: flex; align-items: center; gap: 8px;">
                <input type="range" id="new-thrall-ring-scale" min="0.5" max="5" step="0.05" value="1" style="width: 100px;" disabled>
                <input type="number" min="0.5" max="5" step="0.05" value="1" style="width: 58px; text-align: right; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid #555;" id="new-thrall-ring-scale-val" title="Type an exact value" disabled>
            </div>
        </div>
        <div class="form-group checkbox-group" style="margin-bottom: 10px;">
            <label><input type="checkbox" id="new-thrall-ring-link" checked> Ring subject scale matches token art scale</label>
        </div>

        <button type="button" id="save-thrall-btn" class="add-thrall-btn"><i class="fas fa-plus"></i> Add to Portfolio</button>
    </section>
</div>